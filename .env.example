# Cloud 9 configuration. Copy to .env and fill in:  cp .env.example .env

# Public base URL players use (no trailing slash). Join links + QR codes are built from it.
# https:// here also turns on Secure cookies — use http://<server-ip>:3000 only for temporary testing.
PUBLIC_URL=https://quiz.example.com

# Only needed with the Caddy profile (docker compose --profile caddy up -d): the hostname Caddy gets a cert for.
DOMAIN=quiz.example.com

# Signs moderator session cookies. 32+ random chars. Generate with:  openssl rand -hex 32
# If unset, a random one is generated at boot and moderators get logged out on every restart.
SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Moderator accounts: username:password[:super], comma-separated. "super" sees/controls every room.
# Usernames: a-z 0-9 _ . -  (lowercased). Passwords may not contain commas.
MODERATORS=admin:CHANGE_ME:super,mod1:CHANGE_ME,mod2:CHANGE_ME

# Max players per room (default 500).
MAX_PLAYERS_PER_ROOM=500

# Server log level: fatal | error | warn | info | debug (default warn).
LOG_LEVEL=warn

# Inside Docker these are fixed by the Dockerfile/docker-compose.yml; only set them when running without Docker
# (defaults: PORT=3000, HOST=0.0.0.0, DB_PATH=./data/cloud9.db, WEB_DIST=./dist/web).
# PORT=3000
# HOST=0.0.0.0
# DB_PATH=/data/cloud9.db
# WEB_DIST=/app/dist/web

# Join rate limit per IP per minute. Venue Wi-Fi puts everyone behind ONE public IP, so keep this high.
JOIN_RATE_PER_MIN=1000

# Moderator login attempts per IP per minute (default 5). Moderators sharing venue Wi-Fi share one IP, so allow a few more.
LOGIN_RATE_PER_MIN=20

# WebSocket caps. Venue Wi-Fi puts every phone behind ONE public IP, so keep the per-IP cap far above the audience size.
# Max concurrent sockets per client IP (default 1500) and in total (default 20000). Extra sockets are closed with 4429.
# WS_MAX_PER_IP=1500
# WS_MAX_TOTAL=20000

# Failed room-code lookups (unknown code via GET /api/play/:code or /ws) per IP per minute (default 600).
# Over the limit that IP gets 429 / WS close 4429 for the rest of the minute. Valid codes never count.
# PLAY_LOOKUP_RATE_PER_MIN=600

# ── Telegram bot (optional) ── OFF unless TELEGRAM_BOT_TOKEN is set. Full guide: docs/TELEGRAM.md
# Bot token from @BotFather (/newbot).
# TELEGRAM_BOT_TOKEN=7412345678:AAH-your-token
# Where notifications go: group/supergroup ids (-100…) and/or admins' user ids (private chats), comma-separated. Never gets emails in groups.
# TELEGRAM_NOTIFY_CHAT_IDS=-1001234567890,123456789
# Telegram USER ids allowed to run commands (get yours from @userinfobot). Their private chats may see emails + CSV files.
# TELEGRAM_ADMIN_IDS=123456789
# Forum topic per moderator username (from MODERATORS), plus admin (fallback) and system. Topic id = 2nd number in t.me/c/<chat>/<topic>/<msg>.
# TELEGRAM_TOPICS=mod1=12,mod2=13,admin=15,system=16
# Event leaderboard digest every N minutes while a session is live (default 30, 0 = off).
# TELEGRAM_DIGEST_MINUTES=30
# One line per closed question (default 0 = off).
# TELEGRAM_NOTIFY_QUESTIONS=0
# Send the results CSV to admins' private chats when a session finishes (default 1).
# TELEGRAM_SEND_CSV=1
