{
  "name": "cloud9",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --packages=external",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.mjs",
    "test": "tsx --test --test-concurrency=1 server/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "loadtest": "tsx loadtest/bots.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "playwright": "*",
    "preact": "^10.27.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
